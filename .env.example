# LEGION Platform Configuration

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Database (PostgreSQL + Drizzle ORM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/legion

# Future LLM Provider Configurations (Provider Abstraction Layer)
# Supported: openai | anthropic | google | local_ollama | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o

# Future Sandbox Provider Configurations (Isolated Runtime)
# Supported: docker | e2b | firecracker | mock
SANDBOX_PROVIDER=mock
SANDBOX_TIMEOUT_MS=120000

# Future Git Provider Configurations
# Supported: github | gitlab | local | mock
GIT_PROVIDER=mock
GITHUB_TOKEN=

# Execution Limits & Guardrails
MAX_MISSION_ITERATIONS=50
MAX_AGENT_RETRIES=3
MAX_MISSION_COST_USD=10.00
APPROVAL_REQUIRED_FOR_MIGRATIONS=true
APPROVAL_REQUIRED_FOR_DEPLOYS=true
