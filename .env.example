# LEGION Platform Configuration

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Database (PostgreSQL + Drizzle ORM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/legion

# LLM Provider Configurations (Provider Abstraction Layer)
# Supported: google | openai | anthropic | local_ollama | mock
LLM_PROVIDER=google
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Sandbox Provider Configurations (Phase 02B Real Execution)
# Supported: e2b | mock
SANDBOX_PROVIDER=e2b
E2B_API_KEY=
SANDBOX_TIMEOUT_MS=30000
MAX_OUTPUT_BYTES=65536
MAX_TERMINAL_LINES=500

# Git Provider Configurations
# Supported: github | gitlab | local | mock
GIT_PROVIDER=mock
GITHUB_TOKEN=

# Execution Limits & Guardrails
MAX_MISSION_ITERATIONS=50
MAX_AGENT_RETRIES=3
MAX_MISSION_COST_USD=10.00
APPROVAL_REQUIRED_FOR_MIGRATIONS=true
APPROVAL_REQUIRED_FOR_DEPLOYS=true
